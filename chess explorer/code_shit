# ==========================
# EXPLORER MODE (TREE NAVIGATION)
# ==========================

def explorer_mode(tree):
    """
    Allows user to explore the opening tree interactively.
    Uses recursion to keep exploring deeper positions.
    """

    print("\n==============================")
    print("   CHESS OPENING EXPLORER")
    print("==============================\n")
    print("Type moves like: e4, Nf3, Bb5, d4, c5")
    print("Type 'back' to go back one move.")
    print("Type 'exit' to return to main menu.\n")

    move_history = []
    current_node = tree.root

    while True:
        print("\n----------------------------------")
        print("Current line:", " ".join(move_history) if move_history else "(start position)")
        print("Games reaching this position:", current_node.frequency)

        common = current_node.get_most_common_moves(limit=6)

        if not common:
            print("No more moves stored from this position.")
        else:
            print("\nMost common continuations:")
            for i, child in enumerate(common, start=1):
                print(f"  {i}. {child.move}  ({child.frequency} games)")

        if current_node.plans:
            print("\nTypical plans:")
            for plan in current_node.plans:
                print(" -", plan)

        if current_node.mistakes:
            print("\nCommon mistakes:")
            for mistake in current_node.mistakes:
                print(" -", mistake)

        user = input("\nEnter move: ").strip()

        if user.lower() == "exit":
            break

        if user.lower() == "back":
            if move_history:
                move_history.pop()
                current_node = tree.find_node(move_history) if move_history else tree.root
            else:
                print("You are already at the start.")
            continue

        if user not in current_node.children:
            print("Move not found in database.")
            continue

        move_history.append(user)
        current_node = current_node.children[user]


# ==========================
# QUIZ / TRAINING MODE
# ==========================

def gather_positions(node, history=None, depth_limit=12):
    """
    Recursively gathers all possible opening positions from the tree.
    Returns a list of tuples: (move_sequence, node)
    """

    if history is None:
        history = []

    positions = [(history, node)]

    if len(history) >= depth_limit:
        return positions

    for child_move, child_node in node.children.items():
        positions.extend(gather_positions(child_node, history + [child_move], depth_limit))

    return positions


def quiz_mode(tree):
    """
    Quiz mode:
    - shows user an opening sequence
    - asks for best continuation based on frequency
    """

    print("\n==============================")
    print("     OPENING QUIZ MODE")
    print("==============================\n")

    all_positions = gather_positions(tree.root, depth_limit=10)

    # Filter out positions with at least 2 possible continuations
    quiz_positions = [p for p in all_positions if len(p[1].children) >= 2]

    if not quiz_positions:
        print("Not enough opening data to run quiz.")
        return

    score = 0
    rounds = 5

    for round_num in range(1, rounds + 1):
        seq, node = random.choice(quiz_positions)

        print("\n----------------------------------")
        print(f"Round {round_num}/{rounds}")
        print("Opening line so far:", " ".join(seq) if seq else "(start position)")

        common_moves = node.get_most_common_moves(limit=4)

        if not common_moves:
            print("No continuations available.")
            continue

        # Correct answer is the most frequent child
        correct = common_moves[0].move

        options = [child.move for child in common_moves]
        random.shuffle(options)

        print("\nChoose the best continuation:")
        for i, move in enumerate(options, start=1):
            print(f"  {i}. {move}")

        try:
            choice = int(input("\nYour choice (number): ").strip())
            user_move = options[choice - 1]
        except:
            print("Invalid input. Skipping round.")
            continue

        if user_move == correct:
            print("Correct!")
            score += 1
        else:
            print("Wrong.")
            print("Most common move was:", correct)

    print("\n==============================")
    print("QUIZ COMPLETE")
    print("==============================")
    print("Final score:", score, "/", rounds)
    print()


