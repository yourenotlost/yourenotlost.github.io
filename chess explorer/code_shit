            ]
        },

        ("d4", "d5", "c4"): {
            "name": "Queen's Gambit",
            "plans": [
                "White offers the c-pawn to gain central control.",
                "White usually aims for Nc3 and developing pieces naturally.",
                "Black can accept or decline the gambit depending on style."
            ],
            "mistakes": [
                "Accepting the gambit but not defending the pawn can lose material.",
                "White overextending the centre too early can be punished.",
