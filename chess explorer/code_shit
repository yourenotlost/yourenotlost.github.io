import random
import os
from collections import defaultdict


# ==========================
# DATA STRUCTURES
# ==========================

class OpeningNode:
    """
    Represents one position in an opening tree.
    Each node stores:
    - move leading into it (like "e4", "Nf3")
    - children nodes (next moves)
    - how many times this position occurred in games
    - plans and mistakes (text notes)
    """

    def __init__(self, move=None):
        self.move = move
        self.children = {}  # move -> OpeningNode
        self.frequency = 0

        # Optional educational content
        self.plans = []
        self.mistakes = []

    def add_child(self, move):
        """Adds a child node if it doesn't exist yet."""
        if move not in self.children:
            self.children[move] = OpeningNode(move)
        return self.children[move]

    def get_most_common_moves(self, limit=5):
        """Returns the most common continuation moves from this position."""
        sorted_children = sorted(
            self.children.values(),
            key=lambda node: node.frequency,
            reverse=True
        )
        return sorted_children[:limit]


class OpeningTree:
    """
    Stores the entire opening database as a tree.
    Root node represents the starting position.
    """

    def __init__(self):
        self.root = OpeningNode("START")

    def insert_game(self, moves):
        """
        Inserts a list of moves into the tree.
        Example: ["e4", "e5", "Nf3", "Nc6"]
        """
        current = self.root
        current.frequency += 1

        for move in moves:
            current = current.add_child(move)
            current.frequency += 1

    def find_node(self, moves):
        """
        Finds the node representing the position after a sequence of moves.
        Returns None if sequence not found.
        """
        current = self.root
        for move in moves:
            if move not in current.children:
                return None
            current = current.children[move]
        return current


# ==========================
# PGN LOADING
# ==========================

def clean_move(move):
    """
    Removes PGN symbols like:
    - move numbers "1."
    - check "+"
    - checkmate "#"
    - annotations "!", "?"
    """
    move = move.strip()

    # Ignore move numbers
    if "." in move:
        return None

    # Ignore game results
    if move in ["1-0", "0-1", "1/2-1/2", "*"]:
        return None

    # Remove punctuation symbols
    for ch in ["+", "#", "!", "?", "!!", "??", "!?"]:
        move = move.replace(ch, "")

    return move.strip()


def load_pgn_file(filepath):
    """
    Loads moves from a PGN file.
    Returns list of games, each game is a list of moves.
    """

    games = []
    current_game_moves = []

    with open(filepath, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()

            # Ignore PGN metadata tags like [Event "..."]
            if line.startswith("["):
                continue

            # Empty line usually ends game
            if line == "":
                if current_game_moves:
                    games.append(current_game_moves)
                    current_game_moves = []
                continue

            # Split line into tokens
            tokens = line.split()

            for token in tokens:
                move = clean_move(token)
                if move:
                    current_game_moves.append(move)

    if current_game_moves:
        games.append(current_game_moves)

    return games


