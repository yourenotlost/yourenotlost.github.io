# ==========================
# MAIN MENU
# ==========================

def main():
    tree = OpeningTree()

    print("====================================")
    print(" CHESS OPENING EXPLORER + TRAINER")
    print("====================================\n")

    print("Loading database...")

    # If user has a PGN file, load it
    pgn_path = "games.pgn"

    if os.path.exists(pgn_path):
        print("PGN file found: games.pgn")
        games = load_pgn_file(pgn_path)
        print("Games loaded:", len(games))

        for g in games:
            tree.insert_game(g)

    else:
        print("No PGN file found.")
        print("Using built-in sample opening database instead.")
        build_sample_database(tree)

    # Attach plans/mistakes to known openings
    attach_opening_notes(tree)

    while True:
        print("\n==============================")
        print("MAIN MENU")
        print("==============================")
        print("1. Explore openings")
        print("2. Quiz mode")
        print("3. Exit")

        choice = input("\nEnter choice: ").strip()

        if choice == "1":
            explorer_mode(tree)

        elif choice == "2":
            quiz_mode(tree)

        elif choice == "3":
            print("Goodbye.")
            break

        else:
            print("Invalid choice.")


if __name__ == "__main__":
    main()